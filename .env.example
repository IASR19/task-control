# PostgreSQL no Railway — use a URL PÚBLICA (Connect → Public URL / TCP Proxy).
# A URL com RAILWAY_PRIVATE_DOMAIN só funciona entre serviços do Railway,
# não na Vercel nem no `npm run dev` da sua máquina.
# Ex.: postgresql://postgres:SENHA@XXXX.proxy.rlwy.net:PORTA/railway
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# true no Railway; false só se o Postgres local não usar TLS
DATABASE_SSL=true

# Segredo longo e aleatório (ex.: openssl rand -base64 48)
JWT_SECRET=troque-por-um-segredo-longo
# Access token no localStorage
JWT_ACCESS_EXPIRES_IN=8h
# Refresh token no localStorage
JWT_REFRESH_EXPIRES_IN=14d

# Google AI Studio / Gemini — nunca commitar a chave
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
